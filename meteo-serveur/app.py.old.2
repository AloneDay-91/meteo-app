import sqlite3
from flask import Flask, request, jsonify, render_template_string

app = Flask(__name__)
DB_PATH = '/app/db/meteo.db'

# Initialisation de la base de données
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS mesures
                 (id INTEGER PRIMARY KEY AUTOINCREMENT,
                  timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
                  temperature REAL,
                  humidity REAL,
                  pressure REAL,
                  gas_resistance REAL)''')
    conn.commit()
    conn.close()

init_db()

# Fonction pour évaluer la qualité de l'air
def evaluate_iaq(gas_res):
    if gas_res == "--":
        return "En attente...", "#6c757d"
    try:
        res = float(gas_res)
        if res > 50: return "Excellente", "#28a745"
        elif res > 20: return "Bonne", "#17a2b8"
        elif res > 10: return "Moyenne", "#ffc107"
        else: return "Mauvaise", "#dc3545"
    except ValueError:
        return "Erreur", "#6c757d"

@app.route('/update', methods=['POST'])
def update_data():
    if request.is_json:
        try:
            data = request.get_json()
            # Vérification basique de la présence des données
            if all(k in data for k in ("temperature", "humidity", "pressure", "gas_resistance")):
                conn = sqlite3.connect(DB_PATH)
                c = conn.cursor()
                c.execute("INSERT INTO mesures (temperature, humidity, pressure, gas_resistance) VALUES (?, ?, ?, ?)",
                          (data['temperature'], data['humidity'], data['pressure'], data['gas_resistance']))
                conn.commit()
                conn.close()
                return jsonify({"status": "success"}), 200
            else:
                return jsonify({"status": "missing keys"}), 400
        except Exception as e:
            print(f"Erreur serveur: {e}")
            return jsonify({"status": "server error"}), 500
            
    return jsonify({"status": "bad request"}), 400

@app.route('/')
def index():
    # Récupération de la dernière mesure enregistrée
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT temperature, humidity, pressure, gas_resistance FROM mesures ORDER BY timestamp DESC LIMIT 1")
    row = c.fetchone()
    conn.close()

    if row:
        d = {"temperature": row[0], "humidity": row[1], "pressure": row[2], "gas_resistance": row[3]}
    else:
        # Valeurs par défaut si la base est vide
        d = {"temperature": "--", "humidity": "--", "pressure": "--", "gas_resistance": "--"}
        
    iaq_text, iaq_color = evaluate_iaq(d["gas_resistance"])
    
    html_template = """
    <!DOCTYPE html>
    <html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Station Météo & IAQ</title>
        <style>
            body { font-family: 'Segoe UI', Tahoma, sans-serif; text-align: center; margin-top: 50px; background-color: #e9ecef; }
            .card { background: white; padding: 30px; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); display: inline-block; text-align: left;}
            h1 { color: #343a40; text-align: center; border-bottom: 2px solid #dee2e6; padding-bottom: 10px; }
            p { font-size: 1.2em; color: #495057; margin: 15px 0; }
            .badge { color: white; padding: 5px 12px; border-radius: 20px; font-weight: bold; font-size: 0.9em; }
        </style>
    </head>
    <body>
        <div class="card">
            <h1>Données Environnementales</h1>
            <p>🌡️ Température : <strong>{{ d.temperature }} °C</strong></p>
            <p>💧 Humidité : <strong>{{ d.humidity }} %</strong></p>
            <p>⏱️ Pression : <strong>{{ d.pressure }} hPa</strong></p>
            <hr>
            <p>🌬️ Qualité de l'air : <span class="badge" style="background-color: {{ color }};">{{ text }}</span></p>
        </div>
    </body>
    </html>
    """
    return render_template_string(html_template, d=d, text=iaq_text, color=iaq_color)
